{
  "expo": {
    "name": "Motor Care",
    "slug": "motorcycle-care",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "motorcare",
    "icon": "./assets/branding/icon.png",
    "web": {
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-calendar",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan Motor Care mengakses foto untuk profil motor.",
          "cameraPermission": "Izinkan Motor Care menggunakan kamera untuk memotret motor.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F6F9",
          "dark": {
            "image": "./assets/branding/splash-dark.png",
            "backgroundColor": "#0D131D"
          }
        }
      ]
    ],
    "android": {
      "package": "com.motorcare.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "monochromeImage": "./assets/branding/adaptive-monochrome.png",
        "backgroundColor": "#2563EB"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.motorcare.app"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "99ecf4c9-2bfd-458f-803e-4496af56481e"
      }
    },
    "owner": "jayfortune03"
  }
}
